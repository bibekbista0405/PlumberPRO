# LOCAL DEVELOPMENT — BACKEND
# Copy to .env and replace PGPASSWORD + JWT_SECRET.
# For Vercel deployment, use .env.vercel.example and VERCEL_ENV_SETUP.md.

NODE_ENV=development
PORT=5000

PGHOST=pg-4ba8067-bibekbista0405-fcae.l.aivencloud.com
PGPORT=27197
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=REPLACE_WITH_YOUR_AIVEN_SERVICE_PASSWORD
PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=true
PGSSL_CA_FILE=./certs/aiven-ca.pem
PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=15000

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=1

# Optional SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PlumbPro <no-reply@yourdomain.com>

# Optional web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Optional error monitoring
SENTRY_DSN=
