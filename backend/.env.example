PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=plumber_portal
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Trusted proxy hops for express-rate-limit / req.ip (see backend/src/server.js).
# 1 = a single reverse proxy / load balancer / tunnel in front of the app (typical).
# false = no proxy at all. A number = that many hops.
TRUST_PROXY=1

# Optional — email (see NOTIFICATIONS_SETUP.md). Leave unset to disable.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=PlumbPro <no-reply@yourdomain.com>

# Optional — web push (see NOTIFICATIONS_SETUP.md). Generate with:
#   node backend/scripts/generate-vapid-keys.js
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=

# Optional — error monitoring. Leave unset to disable.
# SENTRY_DSN=

# Optional Aiven PostgreSQL connection details.
# IMPORTANT: The current PlumberPRO backend uses mysql2/MySQL. These values are
# stored for the planned PostgreSQL migration and are NOT used by src/config/db.js.
# Do not switch DB_HOST to this PostgreSQL host; that would break the current app.
AIVEN_PG_HOST=pg-4ba8067-bibekbista0405-fcae.l.aivencloud.com
AIVEN_PG_PORT=27197
AIVEN_PG_DATABASE=defaultdb
AIVEN_PG_USER=avnadmin
AIVEN_PG_PASSWORD=REPLACE_WITH_YOUR_AIVEN_PASSWORD
AIVEN_PG_SSL=true
AIVEN_PG_SSL_REJECT_UNAUTHORIZED=true
AIVEN_PG_SSL_CA_FILE=./certs/aiven-ca.pem
