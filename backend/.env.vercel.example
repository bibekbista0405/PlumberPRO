# PlumberPRO BACKEND — VERCEL + AIVEN POSTGRESQL
# Copy these KEY=VALUE entries into Vercel > plumberpro-api > Settings > Environment Variables.
# Replace ONLY values marked REPLACE_... or YOUR_...
# Keep this file private. Never commit your real .env file or database password.

NODE_ENV=production
PORT=5000

# Aiven PostgreSQL connection
PGHOST=pg-4ba8067-bibekbista0405-fcae.l.aivencloud.com
PGPORT=27197
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=REPLACE_WITH_YOUR_AIVEN_SERVICE_PASSWORD
PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=true
PGSSL_CA_FILE=./certs/aiven-ca.pem

# Serverless-friendly pool size. Keep low when deploying multiple Vercel functions.
PGPOOL_MAX=3
PGCONNECT_TIMEOUT_MS=15000

# Authentication — generate a unique random secret; do not reuse your Aiven password.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# Frontend origin — replace with the actual deployed frontend URL.
# For multiple origins, separate URLs with commas.
FRONTEND_URL=https://YOUR-FRONTEND-PROJECT.vercel.app
TRUST_PROXY=1

# Optional email notifications. Leave empty until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PlumbPro <no-reply@yourdomain.com>

# Optional web push. Leave empty to disable until VAPID keys are generated.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Optional error monitoring. Leave empty to disable.
SENTRY_DSN=
